{
  "name": "easydocstation-server",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "seed": "node seed.js",
    "init:channel-mapping-index": "node scripts/init-channel-mapping-index.js",
    "reset-db": "node -e \"const { initCassandra, client } = require('./cassandra'); (async () => { await initCassandra(); await client.execute('DROP TABLE IF EXISTS posts'); await client.execute('DROP TABLE IF EXISTS attachments'); console.log('Tables dropped'); process.exit(0); })()\"",
    "migrate:encrypt-sns-secrets": "node scripts/migrate-encrypt-sns-secrets.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cassandra-driver": "^4.8.0",
    "content-disposition": "^0.5.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.10.0",
    "imapflow": "^1.4.3",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.12",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.1",
    "pg": "^8.11.5",
    "redis": "^6.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}

EASYSTATION_TAG=latest
APP_BIND_IP=0.0.0.0
APP_PORT=3001
CLIENT_ORIGIN=http://localhost:3001
EASYSTATION_STORAGE_DIR=/home/ubuntu/EasyDocStation-data/storage
EASYSTATION_DATA_DIR=/home/ubuntu/EasyDocStation-data/storage/app
EASYSTATION_CONFIG_FILE=/home/ubuntu/EasyDocStation-data/config/config.json
POSTGRES_USER=easydocstation
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=easydocstation
CASSANDRA_KEYSPACE=easydocstation
CASSANDRA_MAX_HEAP=2G
CASSANDRA_HEAP_NEWSIZE=400M
REDIS_MAXMEMORY=4gb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_AI_CACHE_ENABLED=true
REDIS_AI_QUEUE_ENABLED=false
REDIS_AI_VECTOR_CACHE_ENABLED=false
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_BYTES
DATA_ENCRYPTION_KEY=
HF_TOKEN=
OLLAMA_MODEL=gemma4:e4b
# AWS ECR/ECS deployment
AWS_REGION=ap-northeast-2
# Empty means: resolve automatically with aws sts get-caller-identity
AWS_ACCOUNT_ID=
ECR_REPOSITORY=easydocstation
# true allows build-container.sh to create a missing ECR repository
ECR_CREATE_REPOSITORY=false
ECS_CLUSTER=
ECS_SERVICE=
# Container name inside the existing ECS Task Definition
ECS_CONTAINER_NAME=app
ECS_WAIT_FOR_STABLE=true
